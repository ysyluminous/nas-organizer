# ============================================================
# 复制为 .env 后按你的 NAS 实际情况修改
# 路径一律写【宿主机（NAS）上的绝对路径】，不要写容器内路径
# ============================================================

# ---- 网络 ----
# 只绑内网 IP 最安全；需要局域网访问就改成 NAS 的 IP，如 192.168.1.100
LISTEN_IP=127.0.0.1
WEB_PORT=8765
TZ=Asia/Shanghai

# ---- 权限（重要）----
# 改成 NAS 上拥有共享文件夹权限的用户 UID / GID
# 查看方法见 docs/挂载配置指南.md
PUID=1000
PGID=1000

# ---- 扫描源（只读）----
# 写成你的共享文件夹实际路径，例如：
#   群晖：  /volume1/photo
#   威联通：/share/ Multimedia
#   飞牛：  /vol1/1000/Media
#   绿联：  /volume5/16t2
#   通用：  /mnt/nas/share
# 需要多个盘就再定义 SCAN_2、SCAN_3，并在 docker-compose.yml 中取消对应行的注释
SCAN_1=./example-media
# SCAN_2=/volume2/共享文件夹
# SCAN_3=/volume3/共享文件夹

# ---- 写入目标（读写）----
# 建议指向一个专门的「待归档」目录，不要直接指向共享文件夹根目录
WRITE_TARGET=./example-target

# ---- 备份目标（可选）----
BACKUP_TARGET=./example-backup

# ---- 启动权限自检（可选）----
# 逗号分隔的「容器内」挂载路径；属主与 PUID/PGID 不符时打印修复命令，不自动改权限
# 不检查的目录直接删掉或留空
MOUNT_CHECK_PATHS=/scan/media1,/write/target

# ---- 调试（生产保持 0）----
NAS_ORGANIZER_DOCS=0
